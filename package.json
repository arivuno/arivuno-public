{
	"name": "arivuno",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"description": "A local-first Chromium extension that removes YouTube Shorts entry points and interrupts Shorts pages.",
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"postinstall": "wxt prepare",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "bun run build && playwright test",
		"test:e2e:built": "playwright test",
		"verify:build": "bun run build && node scripts/verify-build.mjs",
		"lint": "bun run lint:code && bun run lint:css",
		"lint:code": "oxlint --max-warnings 0 --report-unused-disable-directives",
		"lint:code:fix": "oxlint --fix --max-warnings 0 --report-unused-disable-directives",
		"lint:css": "stylelint \"**/*.css\" --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --report-descriptionless-disables",
		"lint:css:fix": "stylelint \"**/*.css\" --fix --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --report-descriptionless-disables",
		"lint:fix": "bun run lint:code:fix && bun run lint:css:fix",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run verify:build && bun run test:e2e:built",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"happy-dom": "20.11.2",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"stylelint": "17.14.1",
		"stylelint-config-standard": "40.0.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"wxt": "0.21.3"
	}
}
